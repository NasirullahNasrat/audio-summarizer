# Django Settings
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=sqlite:///db.sqlite3

# Redis (for Celery)
# Leave empty for local dev without Redis; app falls back to memory broker
REDIS_URL=

# API Keys
# IMPORTANT: Replace with your actual OpenAI API key from https://platform.openai.com/account/api-keys
# A valid key should start with 'sk-' and be approximately 51 characters long
OPENAI_API_KEY=your-openai-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# API Configuration
DEFAULT_API_PROVIDER=openai
WHISPER_MODEL=whisper-1
SUMMARY_MODEL=gpt-3.5-turbo
MAX_FILE_SIZE_MB=25

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Cost Configuration (per 1K tokens)
OPENAI_COST_INPUT=0.001
OPENAI_COST_OUTPUT=0.002
DEEPSEEK_COST_INPUT=0.001
DEEPSEEK_COST_OUTPUT=0.002

# Rate Limiting
RATE_LIMIT_PER_HOUR=10
